url:"https://cloud.google.com/bigquery/docs/reference/standard-sql/functions-and-operators#lag"},{name:"LAST_DAY",args:"datetime_expression [, date_part]",description:"Returns the last day from the <datetime_expression> that contains the date. This is commonly used to return the last day of the month. You can optionally specify the <date_part> for which the last day is returned. If this parameter is not used, the default value is MONTH.",url:"https://cloud.google.com/bigquery/docs/reference/standard-sql/datetime_functions#last_day"},
{name:"LAST_VALUE",args:"value_expr",description:"Returns the value of the <value_expr> for the last row in the current window frame.",url:"https://cloud.google.com/bigquery/docs/reference/standard-sql/functions-and-operators#last_value"},{name:"LAX_BOOL",args:"json_expr",description:"Attempts to convert a JSON value to a SQL BOOL value.",url:(k=this.docsUrls)==null?void 0:k.CONSOLE__BIGQUERY_DOCS_REFERENCE_STANDARD_SQL_JSON_FUNCTIONS_LAX_BOOL},{name:"LAX_FLOAT64",args:"json_expr",description:"Attempts to convert a JSON expression to a SQL FLOAT64 value.",
